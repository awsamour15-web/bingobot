generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Player {
  id                   String               @id @default(uuid())
  telegram_id          BigInt               @unique
  username             String
  phone                String?
  phone_verified       Boolean              @default(false)
  is_suspended         Boolean              @default(false)
  is_mock              Boolean              @default(false)
  referrer_id          String?
  created_at           DateTime             @default(now())
  agent_id             String?
  agent_commissions       AgentCommission[]
  cartela_reservations    CartelaReservation[]
  won_rounds              GameRound[]          @relation("RoundWinner")
  pending_deposits        PendingDeposit[]
  pending_withdrawals     PendingWithdrawal[]
  agent                   Agent?               @relation(fields: [agent_id], references: [id])
  referrer                Player?              @relation("PlayerReferrals", fields: [referrer_id], references: [id])
  referrals               Player[]             @relation("PlayerReferrals")
  round_entries           RoundEntry[]
  round_wins              RoundWinner[]
  wallets                 Wallet[]
  bonus_distributions     PromotionBonusDistribution[]
  crash_bets              CrashBet[]
  slot_spins              SlotSpin[]
  keno_bets               KenoBet[]
  deposit_attempts        DepositAttempt[]

  @@index([telegram_id])
  @@index([referrer_id])
  @@index([agent_id])
  @@index([is_mock])
  @@map("players")
}

model Wallet {
  id           String        @id @default(uuid())
  player_id    String
  type         WalletType
  balance      Decimal       @default(0) @db.Decimal(14, 2)
  updated_at   DateTime      @updatedAt
  transactions Transaction[]
  player       Player        @relation(fields: [player_id], references: [id])

  @@unique([player_id, type])
  @@index([player_id])
  @@map("wallets")
}

model Transaction {
  id           String   @id @default(uuid())
  wallet_id    String
  type         TxType
  amount       Decimal  @db.Decimal(14, 2)
  reference_id String?
  note         String?
  created_at   DateTime @default(now())
  wallet       Wallet   @relation(fields: [wallet_id], references: [id])

  @@index([wallet_id])
  @@index([created_at])
  @@map("transactions")
}

model GameRound {
  id                    String               @id @default(uuid())
  stake                 Decimal              @db.Decimal(14, 2)
  status                GameStatus           @default(pending)
  max_players           Int
  start_time            DateTime
  ended_at              DateTime?
  derash                Decimal              @default(0) @db.Decimal(14, 2)
  commission_pct        Float
  winner_player_id      String?
  winner_cartela_number Int?
  called_numbers        CalledNumber[]
  cartela_reservations  CartelaReservation[]
  winner                Player?              @relation("RoundWinner", fields: [winner_player_id], references: [id])
  round_entries         RoundEntry[]
  round_winners         RoundWinner[]

  @@index([status])
  @@index([start_time])
  @@map("game_rounds")
}

model RoundEntry {
  id             String    @id @default(uuid())
  round_id       String
  player_id      String
  cartela_number Int
  is_watching    Boolean   @default(false)
  joined_at      DateTime  @default(now())
  player         Player    @relation(fields: [player_id], references: [id])
  round          GameRound @relation(fields: [round_id], references: [id])

  @@unique([round_id, cartela_number])
  @@index([round_id])
  @@index([player_id])
  @@index([round_id, is_watching])
  @@map("round_entries")
}

model RoundWinner {
  id             String    @id @default(uuid())
  round_id       String
  player_id      String
  cartela_number Int
  split_amount   Decimal   @db.Decimal(14, 2)
  created_at     DateTime  @default(now())
  player         Player    @relation(fields: [player_id], references: [id])
  round          GameRound @relation(fields: [round_id], references: [id])

  @@unique([round_id, player_id])
  @@index([round_id])
  @@map("round_winners")
}

model CartelaDefinition {
  cartela_number Int   @id
  /// 25-element flat int array (row-major). Index 12 = free space = 0.
  grid           Int[]

  @@map("cartela_definitions")
}

model CalledNumber {
  id             String    @id @default(uuid())
  round_id       String
  number         Int
  sequence_index Int
  called_at      DateTime  @default(now())
  round          GameRound @relation(fields: [round_id], references: [id])

  @@unique([round_id, number])
  @@unique([round_id, sequence_index])
  @@index([round_id])
  @@map("called_numbers")
}

model Admin {
  id            String    @id @default(uuid())
  username      String    @unique
  password_hash String
  role          AdminRole @default(admin)
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())

  @@map("admins")
}

model Config {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt

  @@map("config")
}

model PendingDeposit {
  id         String           @id @default(uuid())
  tx_number  String           @unique
  amount     Decimal          @db.Decimal(14, 2)
  status     DepositStatus    @default(pending)
  player_id  String?
  claimed_at DateTime?
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt
  player     Player?          @relation(fields: [player_id], references: [id])
  attempts   DepositAttempt[]

  @@index([status])
  @@index([player_id])
  @@map("pending_deposits")
}

model DepositAttempt {
  id                String              @id @default(uuid())
  deposit_id        String?             // null when tx_number not found in DB
  player_id         String?
  tx_number_parsed  String?             // tx number extracted from SMS (may differ from deposit)
  raw_sms           String?             // full SMS text the player submitted
  outcome           DepositAttemptOutcome
  failure_reason    String?             // e.g. PHONE_MISMATCH, AMOUNT_MISMATCH, NOT_FOUND, etc.
  amount_expected   Decimal?            @db.Decimal(14, 2)
  amount_parsed     Decimal?            @db.Decimal(14, 2)
  source            String              @default("bot") // "bot" | "admin"
  created_at        DateTime            @default(now())
  deposit           PendingDeposit?     @relation(fields: [deposit_id], references: [id])
  player            Player?             @relation(fields: [player_id], references: [id])

  @@index([deposit_id])
  @@index([player_id])
  @@index([outcome])
  @@index([created_at])
  @@map("deposit_attempts")
}

enum DepositAttemptOutcome {
  success
  failure
  pending_approval
}

model Agent {
  id                 String            @id @default(uuid())
  telegram_username  String
  telegram_id        BigInt?           @unique
  agent_invite_code  String            @unique
  is_active          Boolean           @default(true)
  approval_status    AgentApprovalStatus @default(pending)
  commission_balance Decimal                      @default(0) @db.Decimal(14, 2)
  created_at         DateTime                     @default(now())
  approved_at        DateTime?
  approved_by        String?
  referred_players   AgentCommission[]            @relation("AgentCommissions")
  withdrawals        AgentCommissionWithdrawal[]
  players            Player[]

  @@index([approval_status])
  @@map("agents")
}

enum AgentApprovalStatus {
  pending
  approved
  rejected
}

model AgentCommission {
  id                String   @id @default(uuid())
  agent_id          String
  player_id         String
  deposit_id        String   @unique
  deposit_amount    Decimal  @db.Decimal(14, 2)
  commission_amount Decimal  @db.Decimal(14, 2)
  created_at        DateTime @default(now())
  agent             Agent    @relation("AgentCommissions", fields: [agent_id], references: [id])
  player            Player   @relation(fields: [player_id], references: [id])

  @@index([agent_id])
  @@index([player_id])
  @@map("agent_commissions")
}

model AgentCommissionWithdrawal {
  id         String             @id @default(uuid())
  agent_id   String
  amount     Decimal            @db.Decimal(14, 2)
  phone      String
  status     WithdrawalStatus   @default(pending)
  tx_number  String?
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt
  agent      Agent              @relation(fields: [agent_id], references: [id])

  @@index([agent_id])
  @@index([status])
  @@map("agent_commission_withdrawals")
}

model CartelaReservation {
  id             String    @id @default(uuid())
  round_id       String
  cartela_number Int
  player_id      String
  expires_at     DateTime
  created_at     DateTime  @default(now())
  player         Player    @relation(fields: [player_id], references: [id], onDelete: Cascade)
  round          GameRound @relation(fields: [round_id], references: [id], onDelete: Cascade)

  @@unique([round_id, cartela_number])
  @@index([round_id])
  @@index([player_id])
  @@index([expires_at])
  @@map("cartela_reservations")
}

enum WalletType {
  main
  play
}

enum TxType {
  deposit
  withdrawal
  game_entry
  game_win
  referral_commission
  admin_credit
  admin_debit
  refund
}

enum GameStatus {
  pending
  active
  completed
  cancelled
  void
}

enum AdminRole {
  admin
  super_admin
}

enum DepositStatus {
  pending
  claimed
  cancelled
}

model DepositAccount {
  id         String   @id @default(uuid())
  phone      String   @unique
  name       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([is_active])
  @@map("deposit_accounts")
}

model PendingWithdrawal {
  id         String             @id @default(uuid())
  player_id  String
  amount     Decimal            @db.Decimal(14, 2)
  phone      String
  status     WithdrawalStatus   @default(pending)
  tx_number  String?
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt
  player     Player             @relation(fields: [player_id], references: [id])

  @@index([status])
  @@index([player_id])
  @@map("pending_withdrawals")
}

model BroadcastTarget {
  id         String   @id @default(uuid())
  name       String
  type       String   // 'channel' | 'bot_broadcast'
  channel_id String?  // Telegram channel/group ID (null for bot_broadcast)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  @@index([is_active])
  @@map("broadcast_targets")
}

model Promotion {
  id              String                @id @default(uuid())
  title           String
  content_type    PromotionContentType
  text_content    String?
  media_file_id   String?
  caption         String?               // optional caption for media promotions
  status          PromotionStatus       @default(active)
  // Bonus fields — null means this promotion has no bonus
  bonus_amount    Decimal?              @db.Decimal(14, 2)
  bonus_wallet    WalletType?
  bonus_criteria  Json?                 // { minBalance?, maxBalance?, minDeposits?, hasPlayedRounds?, daysRegistered?, agentId? }
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt
  schedules       PromotionSchedule[]
  logs            PromotionLog[]
  bonus_distributions PromotionBonusDistribution[]

  @@index([status])
  @@map("promotions")
}

model PromotionBonusDistribution {
  id             String    @id @default(uuid())
  promotion_id   String
  player_id      String
  amount         Decimal   @db.Decimal(14, 2)
  wallet         WalletType
  distributed_at DateTime  @default(now())
  promotion      Promotion @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  player         Player    @relation(fields: [player_id], references: [id], onDelete: Cascade)

  @@unique([promotion_id, player_id])
  @@index([promotion_id])
  @@index([player_id])
  @@map("promotion_bonus_distributions")
}

model PromotionSchedule {
  id           String                      @id @default(uuid())
  promotion_id String
  channel_ids  String[]
  frequency    PromotionScheduleFrequency
  send_at      DateTime
  next_run_at  DateTime?
  is_active    Boolean                     @default(true)
  created_at   DateTime                    @default(now())
  promotion    Promotion                   @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  logs         PromotionLog[]

  @@index([promotion_id])
  @@index([is_active, next_run_at])
  @@map("promotion_schedules")
}

model PromotionLog {
  id            String             @id @default(uuid())
  promotion_id  String
  schedule_id   String?
  channel_id    String
  status        String
  error_message String?
  sent_at       DateTime           @default(now())
  promotion     Promotion          @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  schedule      PromotionSchedule? @relation(fields: [schedule_id], references: [id], onDelete: SetNull)

  @@index([promotion_id])
  @@index([schedule_id])
  @@map("promotion_logs")
}

enum WithdrawalStatus {
  pending
  approved
  rejected
}

enum CrashStatus {
  waiting
  running
  crashed
}

enum SlotSpinStatus {
  win
  loss
}

enum PromotionContentType {
  text
  image
  video
  gif
}

enum PromotionStatus {
  active
  inactive
}

enum PromotionScheduleFrequency {
  once
  daily
  weekly
  monthly
}

// ─── Crash Game ───────────────────────────────────────────────────────────────

model CrashRound {
  id           String          @id @default(uuid())
  status       CrashStatus     @default(waiting)
  crash_point  Float?          // multiplier at which it crashed (null until crashed)
  started_at   DateTime?
  crashed_at   DateTime?
  created_at   DateTime        @default(now())
  bets         CrashBet[]

  @@index([status])
  @@index([created_at])
  @@map("crash_rounds")
}

model CrashBet {
  id           String      @id @default(uuid())
  round_id     String
  player_id    String
  slot         Int         @default(1)  // 1 or 2 — supports dual-bet panels
  bet_amount   Decimal     @db.Decimal(14, 2)
  cashout_at   Float?      // multiplier at cashout (null = not cashed out yet / bust)
  payout       Decimal?    @db.Decimal(14, 2)
  created_at   DateTime    @default(now())
  round        CrashRound  @relation(fields: [round_id], references: [id])
  player       Player      @relation(fields: [player_id], references: [id])

  @@unique([round_id, player_id, slot])
  @@index([round_id])
  @@index([player_id])
  @@map("crash_bets")
}

// ─── Slots Game ───────────────────────────────────────────────────────────────

model SlotSpin {
  id              String         @id @default(uuid())
  player_id       String
  bet_amount      Decimal        @db.Decimal(14, 2)
  reels           Json           // number[][] — 3 columns × 3 rows symbol indices
  multiplier_reel Int            @default(1)
  payline_wins    Json           // { line: number, symbols: number[], payout: number }[]
  total_win       Decimal        @default(0) @db.Decimal(14, 2)
  status          SlotSpinStatus
  gamble_result   Json?          // { guess: 'red'|'black', actual: 'red'|'black', won: bool, payout: number } | null
  created_at      DateTime       @default(now())
  player          Player         @relation(fields: [player_id], references: [id])

  @@index([player_id])
  @@index([created_at])
  @@map("slot_spins")
}

// ─── Keno Game ─────────────────────────────────────────────────────────────

enum KenoStatus {
  betting
  drawing
  finished
}

model KenoRound {
  id              String     @id @default(uuid())
  status          KenoStatus @default(betting)
  drawn_numbers   Int[]
  betting_ends_at DateTime
  started_at      DateTime?
  finished_at     DateTime?
  created_at      DateTime   @default(now())
  bets            KenoBet[]

  @@index([status])
  @@index([created_at])
  @@map("keno_rounds")
}

model KenoBet {
  id              String    @id @default(uuid())
  round_id        String
  player_id       String
  picked_numbers  Int[]
  bet_amount      Decimal   @db.Decimal(14, 2)
  matched         Int?
  payout          Decimal?  @db.Decimal(14, 2)
  created_at      DateTime  @default(now())
  round           KenoRound @relation(fields: [round_id], references: [id])
  player          Player    @relation(fields: [player_id], references: [id])

  @@index([round_id])
  @@index([player_id])
  @@map("keno_bets")
}