{
  "name": "@fidel/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @fidel/shared build && prisma migrate resolve --rolled-back 20260823100000_add_mock_bot_win_config || true && prisma migrate resolve --rolled-back 20260824100000_add_crash_bet_slot || true && prisma migrate deploy && prisma generate && tsc",
    "type-check": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest --run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:backup": "node backup-database.mjs",
    "db:backup:simple": "node simple-backup.mjs",
    "db:backup:shell": "bash backup-database.sh",
    "db:restore": "bash restore-database.sh",
    "verify:bot": "node verify-bot-config.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fidel/shared": "workspace:*",
    "@prisma/client": "5.22.0",
    "@types/bcryptjs": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "4.19.2",
    "express-rate-limit": "7.4.1",
    "grammy": "1.30.0",
    "helmet": "8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "9.0.2",
    "socket.io": "^4.8.3",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "^20.14.0",
    "@types/supertest": "^7.2.1",
    "fast-check": "3.22.0",
    "prisma": "5.22.0",
    "supertest": "^7.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
